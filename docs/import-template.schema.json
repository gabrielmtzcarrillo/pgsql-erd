{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pgsql-erd:excel-pg-insert-template:1.4",
  "title": "Excel to PostgreSQL INSERT template",
  "description": "Maps worksheets of any structurally compatible .xlsx workbook onto ordered INSERT tasks. Version 1.x; a runner must reject any other major version.",
  "type": "object",
  "required": [
    "format",
    "specVersion",
    "templateId",
    "name",
    "sources",
    "execution"
  ],
  "properties": {
    "format": {
      "const": "excel-pg-insert-template"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "limits": {
      "type": "object",
      "description": "Optional ceilings; defaults {\"maxRows\":100000,\"maxScanRows\":200,\"maxColumns\":512}.",
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1
        },
        "maxScanRows": {
          "type": "integer",
          "minimum": 1
        },
        "maxColumns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sheet",
          "header",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 64
          },
          "sheet": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "mode",
                  "value"
                ],
                "properties": {
                  "mode": {
                    "const": "name"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "value"
                ],
                "properties": {
                  "mode": {
                    "const": "index"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "headers"
                ],
                "properties": {
                  "mode": {
                    "const": "requiredHeaders"
                  },
                  "headers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              }
            ]
          },
          "header": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "mode",
                  "row",
                  "startColumn"
                ],
                "properties": {
                  "mode": {
                    "const": "fixed"
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  },
                  "startColumn": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{1,3}$"
                  },
                  "expected": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "match": {
                    "type": "object",
                    "properties": {
                      "trim": {
                        "type": "boolean"
                      },
                      "caseSensitive": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "scanRows"
                ],
                "properties": {
                  "mode": {
                    "const": "detect"
                  },
                  "scanRows": {
                    "type": "object",
                    "required": [
                      "from",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      },
                      "to": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      }
                    }
                  },
                  "match": {
                    "type": "object",
                    "properties": {
                      "trim": {
                        "type": "boolean"
                      },
                      "caseSensitive": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "firstRow",
              "endMode"
            ],
            "properties": {
              "firstRow": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "afterHeader"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "endMode": {
                "const": "lastNonEmptyMappedRow"
              },
              "skipEmptyRows": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "description": "Values the person running the import picks (1.1), used by mappings with source.mode \"parameter\".",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "maxLength": 256
          },
          "default": {
            "type": "string",
            "maxLength": 1000,
            "description": "Value selected at first; the runner may override it."
          },
          "source": {
            "type": "object",
            "required": [
              "type",
              "schema",
              "table",
              "valueColumn"
            ],
            "description": "A dropdown of the rows of a table: the value of valueColumn is used, labelColumn is what the person reads and searches.",
            "properties": {
              "type": {
                "const": "table"
              },
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "table": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "valueColumn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "labelColumn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "filter": {
                "type": "object",
                "required": [
                  "column"
                ],
                "description": "Only the rows whose `column`, as text, equals the value are offered (1.4). The value is either `value` (fixed) or `parameter` (the value picked in another dropdown); give exactly one.",
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "parameter": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                    "maxLength": 64
                  }
                }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "operation",
        "transaction",
        "tasks"
      ],
      "properties": {
        "operation": {
          "const": "insert"
        },
        "transaction": {
          "enum": [
            "atomic",
            "perTask"
          ]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "order",
              "sourceId",
              "target",
              "mappings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "maxLength": 64
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "maxLength": 64
              },
              "target": {
                "type": "object",
                "required": [
                  "schema",
                  "table"
                ],
                "properties": {
                  "schema": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  }
                }
              },
              "mappings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "targetColumn"
                  ],
                  "properties": {
                    "source": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "mode",
                            "column"
                          ],
                          "properties": {
                            "mode": {
                              "const": "column"
                            },
                            "column": {
                              "type": "string",
                              "pattern": "^[A-Za-z]{1,3}$"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "mode",
                            "name"
                          ],
                          "properties": {
                            "mode": {
                              "const": "header"
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "mode",
                            "name"
                          ],
                          "properties": {
                            "mode": {
                              "const": "parameter"
                            },
                            "name": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                              "maxLength": 64
                            }
                          },
                          "description": "A value chosen when the import runs (1.1)."
                        },
                        {
                          "type": "object",
                          "required": [
                            "mode",
                            "taskId",
                            "column"
                          ],
                          "description": "The value of `column` that the INSERT of an earlier task returned (RETURNING) for the same worksheet row (1.3).",
                          "properties": {
                            "mode": {
                              "const": "inserted"
                            },
                            "taskId": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                              "maxLength": 64
                            },
                            "column": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            }
                          }
                        }
                      ]
                    },
                    "processor": {
                      "description": "What happens to the cell text before it is inserted (1.1). Not for parameters.",
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "type"
                          ],
                          "description": "split: the text as an array of strings.",
                          "properties": {
                            "type": {
                              "const": "split"
                            },
                            "delimiter": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 8,
                              "description": "Literal text, default \",\"."
                            },
                            "trim": {
                              "type": "boolean",
                              "description": "Trim each element. Default true."
                            },
                            "dropEmpty": {
                              "type": "boolean",
                              "description": "Drop empty elements. Default true."
                            },
                            "case": {
                              "enum": [
                                "upper",
                                "lower"
                              ],
                              "description": "Convert the text to upper or lower case before cutting it (1.4); what a case block feeding the split does."
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "mode"
                          ],
                          "description": "case (1.4): the text in upper or lower case. With `split` the text is first cut like the split processor and every element is converted: the result is an array.",
                          "properties": {
                            "type": {
                              "const": "case"
                            },
                            "mode": {
                              "enum": [
                                "upper",
                                "lower"
                              ]
                            },
                            "split": {
                              "type": "object",
                              "properties": {
                                "delimiter": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 8,
                                  "description": "Literal text, default \",\"."
                                },
                                "trim": {
                                  "type": "boolean",
                                  "description": "Trim each element. Default true."
                                },
                                "dropEmpty": {
                                  "type": "boolean",
                                  "description": "Drop empty elements. Default true."
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "schema",
                            "table",
                            "matchColumn",
                            "valueColumn"
                          ],
                          "description": "lookup (1.2): the value of valueColumn in the row of the table whose matchColumn equals the cell text, found when the task runs.",
                          "properties": {
                            "type": {
                              "const": "lookup"
                            },
                            "schema": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            },
                            "table": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            },
                            "matchColumn": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            },
                            "valueColumn": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 63
                            },
                            "onMissing": {
                              "enum": [
                                "error",
                                "null"
                              ],
                              "description": "No row matches: error (default) or null."
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "description": "Presentation only (node positions). Runners must ignore it."
    }
  }
}
