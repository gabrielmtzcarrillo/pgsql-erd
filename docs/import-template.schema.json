{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pgsql-erd:excel-pg-insert-template:1.0",
  "title": "Excel to PostgreSQL INSERT template",
  "description": "Maps worksheets of any structurally compatible .xlsx workbook onto ordered INSERT tasks. Version 1.x; a runner must reject any other major version.",
  "type": "object",
  "required": [
    "format",
    "specVersion",
    "templateId",
    "name",
    "sources",
    "execution"
  ],
  "properties": {
    "format": {
      "const": "excel-pg-insert-template"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "limits": {
      "type": "object",
      "description": "Optional ceilings; defaults {\"maxRows\":100000,\"maxScanRows\":200,\"maxColumns\":512}.",
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1
        },
        "maxScanRows": {
          "type": "integer",
          "minimum": 1
        },
        "maxColumns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sheet",
          "header",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 64
          },
          "sheet": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "mode",
                  "value"
                ],
                "properties": {
                  "mode": {
                    "const": "name"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "value"
                ],
                "properties": {
                  "mode": {
                    "const": "index"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "headers"
                ],
                "properties": {
                  "mode": {
                    "const": "requiredHeaders"
                  },
                  "headers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              }
            ]
          },
          "header": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "mode",
                  "row",
                  "startColumn"
                ],
                "properties": {
                  "mode": {
                    "const": "fixed"
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  },
                  "startColumn": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{1,3}$"
                  },
                  "expected": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "match": {
                    "type": "object",
                    "properties": {
                      "trim": {
                        "type": "boolean"
                      },
                      "caseSensitive": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "scanRows"
                ],
                "properties": {
                  "mode": {
                    "const": "detect"
                  },
                  "scanRows": {
                    "type": "object",
                    "required": [
                      "from",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      },
                      "to": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      }
                    }
                  },
                  "match": {
                    "type": "object",
                    "properties": {
                      "trim": {
                        "type": "boolean"
                      },
                      "caseSensitive": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "firstRow",
              "endMode"
            ],
            "properties": {
              "firstRow": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "afterHeader"
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "endMode": {
                "const": "lastNonEmptyMappedRow"
              },
              "skipEmptyRows": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "operation",
        "transaction",
        "tasks"
      ],
      "properties": {
        "operation": {
          "const": "insert"
        },
        "transaction": {
          "enum": [
            "atomic",
            "perTask"
          ]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "order",
              "sourceId",
              "target",
              "mappings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "maxLength": 64
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "maxLength": 64
              },
              "target": {
                "type": "object",
                "required": [
                  "schema",
                  "table"
                ],
                "properties": {
                  "schema": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  }
                }
              },
              "mappings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "targetColumn"
                  ],
                  "properties": {
                    "source": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "mode",
                            "column"
                          ],
                          "properties": {
                            "mode": {
                              "const": "column"
                            },
                            "column": {
                              "type": "string",
                              "pattern": "^[A-Za-z]{1,3}$"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "mode",
                            "name"
                          ],
                          "properties": {
                            "mode": {
                              "const": "header"
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        }
                      ]
                    },
                    "targetColumn": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "read": {
                      "enum": [
                        "text"
                      ],
                      "description": "How the cell is read; only text in 1.0."
                    },
                    "trim": {
                      "type": "boolean",
                      "description": "Trim the cell text. Default false."
                    },
                    "blank": {
                      "enum": [
                        "null",
                        "emptyString",
                        "error"
                      ],
                      "description": "Blank cell: null (default), emptyString or error."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "description": "Presentation only (node positions). Runners must ignore it."
    }
  }
}
