{
  "name": "pgsql-erd",
  "productName": "pgsql-erd",
  "version": "0.1.0",
  "description": "Desktop ERD tool for PostgreSQL that opens and saves pgAdmin .pgerd files",
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "keywords": ["postgresql", "erd", "pgadmin", "pgerd", "electron"],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.github.pgsql-erd",
    "productName": "pgsql-erd",
    "files": ["src/**/*", "package.json"],
    "fileAssociations": [
      {
        "ext": "pgerd",
        "name": "pgAdmin ERD",
        "description": "pgAdmin ERD diagram",
        "role": "Editor",
        "mimeType": "application/x-pgerd"
      }
    ],
    "linux": { "target": ["AppImage", "deb"], "category": "Development" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" }
  }
}
